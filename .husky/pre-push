#!/bin/sh

# Load nvm to ensure Node 20 (required by Next.js 14)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" 2>/dev/null
nvm use default 2>/dev/null || true

# ── Sandbox-first guard ─────────────────────────────────────────────────────
# Capture push refs from stdin FIRST — git passes them on stdin and they can
# only be read once. Must happen before any other stdin read in this script.
PUSH_REFS=$(cat)

# Parse the captured refs to detect whether this push targets main.
# Format per line: <local-ref> <local-sha> <remote-ref> <remote-sha>
PUSHING_TO_MAIN=false
while IFS=' ' read -r _lref _lsha rref _rsha; do
  if [ "$rref" = "refs/heads/main" ]; then
    PUSHING_TO_MAIN=true
    break
  fi
done << ENDPUSHREFS
$PUSH_REFS
ENDPUSHREFS

if [ "$PUSHING_TO_MAIN" = "true" ]; then
  PROD_PROJECT_ID="prj_4UpclHxvYz46p7KRTnXOnF1TT4Iz"
  if grep -q "\"$PROD_PROJECT_ID\"" .vercel/project.json 2>/dev/null; then
    if [ "${ALLOW_PRODUCTION_PUSH_AFTER_SANDBOX_QA:-}" != "1" ]; then
      echo ""
      echo "⛔ PUSH BLOCKED — Sandbox-first rule (CLAUDE.md)"
      echo ""
      echo "   .vercel/project.json → PRODUCTION project (td-operations)."
      echo "   Pushing to main auto-deploys to:"
      echo "     app.tonydurante.us · portal.tonydurante.us · crm.tonydurante.us"
      echo ""
      echo "   Required before pushing to main:"
      echo "   1. Deploy to sandbox first:"
      echo "        Temporarily swap .vercel/project.json → prj_qBcCaljYbydhpus0xAuzZ1VCcj9S"
      echo "        vercel deploy --prod --yes"
      echo "        Restore .vercel/project.json → prj_4UpclHxvYz46p7KRTnXOnF1TT4Iz"
      echo "   2. Browser-verify: open td-operations-sandbox.vercel.app and confirm"
      echo "   3. Get explicit approval from Antonio in the session chat"
      echo ""
      echo "   ⚠️  Do NOT use --no-verify — that skips lint, tests, schema drift, and build."
      echo ""
      echo "   After sandbox QA is confirmed by Antonio, push with:"
      echo "   ALLOW_PRODUCTION_PUSH_AFTER_SANDBOX_QA=1 git push origin main"
      echo ""
      exit 1
    else
      echo "✅ ALLOW_PRODUCTION_PUSH_AFTER_SANDBOX_QA=1 — sandbox QA declared confirmed."
      echo "   Continuing with all safety checks (lint · schema · tests · build)..."
      echo ""
    fi
  fi
fi
# ── End sandbox-first guard ─────────────────────────────────────────────────

# Check if remote is ahead (another machine may have pushed)
git fetch origin main --quiet 2>/dev/null
AHEAD=$(git rev-list HEAD..origin/main --count 2>/dev/null || echo "0")
if [ "$AHEAD" != "0" ] && [ -n "$AHEAD" ]; then
  echo ""
  echo "❌ PUSH BLOCKED — remote is ${AHEAD} commit(s) ahead."
  echo "   Another machine pushed first. Run:"
  echo "   git pull --rebase origin main && npm run build && git push"
  echo ""
  exit 1
fi

# Block hardcoded client-facing domains — use APP_BASE_URL from lib/config.ts
HARDCODED=$(grep -rn "td-operations\.vercel\.app\|offerte\.tonydurante\.us" \
  --include="*.ts" --include="*.tsx" lib/ app/ 2>/dev/null \
  | grep -v "node_modules" \
  | grep -v "lib/config.ts" \
  | grep -v "lib/oauth.ts" \
  | grep -v "lib/mcp/instructions.ts" \
  | grep -v ".well-known" \
  | grep -v "qb/authorize" \
  | grep -v "qb/callback" || true)

if [ -n "$HARDCODED" ]; then
  echo ""
  echo "❌ PUSH BLOCKED — Hardcoded domain found in client-facing code."
  echo "   Use APP_BASE_URL from lib/config.ts instead."
  echo ""
  echo "$HARDCODED"
  echo ""
  exit 1
fi

# P2.4 rule 4 — Block hardcoded absolute /Users/ paths in Claude hook scripts.
# Hook scripts run on every developer's machine; absolute paths break on any
# other setup. Derive paths from $(dirname "$0") or $HOME instead.
HOOK_ABS_PATHS=$(grep -nE '/Users/[A-Za-z]' .claude/hooks/*.sh 2>/dev/null | grep -v '^[^:]*:[0-9]*:[[:space:]]*#' || true)
if [ -n "$HOOK_ABS_PATHS" ]; then
  echo ""
  echo "❌ PUSH BLOCKED — P2.4 rule 4: hardcoded /Users/... path in .claude/hooks/*.sh"
  echo "   Hook scripts must work on every dev machine; use \$(dirname \"\$0\") or \$HOME."
  echo ""
  echo "$HOOK_ABS_PATHS"
  echo ""
  exit 1
fi

# R107 — System Reference Library freshness. If this push changes a DOCUMENTED
# subsystem's code, that subsystem's docs/systems/<x>.md must be updated in the
# same push (the doc travels with the code — this is the anti-rot mechanism).
# Override (rare, deliberate): ALLOW_SYSTEM_DOC_SKIP=1 git push ...
echo "📚 Checking System Reference Library freshness (R107)..."
if [ -f scripts/check-system-docs-freshness.sh ]; then
  sh scripts/check-system-docs-freshness.sh || exit 1
  echo "✅ System docs in sync."
fi

echo "🔍 Running ESLint on changed files..."
CHANGED_TS=$(git diff --name-only --diff-filter=d origin/main...HEAD -- '*.ts' '*.tsx' 2>/dev/null)
if [ -n "$CHANGED_TS" ]; then
  # Capture eslint's real exit code BEFORE piping to tail (a pipe would make
  # $? reflect tail, which always succeeds — the gate would never block).
  ESLINT_OUT=$(echo "$CHANGED_TS" | xargs npx eslint --max-warnings 0 2>&1)
  ESLINT_STATUS=$?
  echo "$ESLINT_OUT" | tail -10
  if [ "$ESLINT_STATUS" -ne 0 ]; then
    echo ""
    echo "❌ PUSH BLOCKED — ESLint errors in changed files."
    echo "   Run 'npm run lint:fix' to auto-fix, or fix manually."
    echo ""
    exit 1
  fi
  echo "✅ ESLint passed."
else
  echo "   No .ts/.tsx files changed — skipping lint."
fi

# P2.5 — Schema drift check. Regenerate types from Supabase and compare to
# the committed files. If they differ, the schema changed and the dev forgot
# to regenerate → block.
#
# Graceful fallback: if gen:types fails (Supabase CLI unavailable, offline,
# auth expired), warn but don't block — pre-push must work on every dev
# machine including offline ones. The CI workflow will still catch drift.
echo "🔄 Checking schema drift (P2.5)..."
# Snapshot current committed types, regenerate, diff, restore on failure.
if npm run gen:types > /tmp/td-gen-types.log 2>&1; then
  if ! git diff --quiet lib/database.types.ts lib/db-check-types.ts 2>/dev/null; then
    echo ""
    echo "❌ PUSH BLOCKED — P2.5: generated DB types differ from committed types."
    echo "   The Supabase schema has drifted. Either:"
    echo "   (a) commit the regenerated types: git add lib/database.types.ts lib/db-check-types.ts && git commit --amend"
    echo "   (b) discard the schema change:    git checkout lib/database.types.ts lib/db-check-types.ts"
    echo ""
    git diff --stat lib/database.types.ts lib/db-check-types.ts
    echo ""
    exit 1
  fi
  echo "✅ Schema in sync."
else
  echo "⚠️  Could not regenerate types (Supabase CLI unavailable or offline). Skipping schema drift check."
  echo "    Details: /tmp/td-gen-types.log"
fi

echo "🧪 Running unit tests before push..."
# Capture the real exit code BEFORE piping to tail (piping would make $? reflect
# tail, which always exits 0 — a failing suite would slip through, 2026-07-08).
npm run test:unit > /tmp/td-unit.log 2>&1
UNIT_STATUS=$?
tail -5 /tmp/td-unit.log

if [ "$UNIT_STATUS" -ne 0 ]; then
  echo ""
  echo "❌ UNIT TESTS FAILED — push blocked."
  echo "   Run 'npm run test:unit' to see failures, fix them, then push again."
  echo ""
  exit 1
fi

echo "🧪 Running integration tests before push (P1.7 characterization)..."
# Capture the real exit code BEFORE piping to tail (same pipe-swallows-$? bug).
npm run test:integration > /tmp/td-integration.log 2>&1
INTEGRATION_STATUS=$?
tail -5 /tmp/td-integration.log

if [ "$INTEGRATION_STATUS" -ne 0 ]; then
  echo ""
  echo "❌ INTEGRATION TESTS FAILED — push blocked."
  echo "   Run 'npm run test:integration' to see failures, fix them, then push again."
  echo ""
  exit 1
fi

# ── CODE ↔ DATABASE CONTRACT ────────────────────────────────────────────────────
# The code must not write values the database will reject. This is the gate that would
# have caught the 2026-07-14 incident, where the matcher wrote a feed status production's
# CHECK constraint forbade — every write rejected, every error discarded, and the review
# queue silently did not exist for months. Three reviewers and five rounds of code review
# missed it, because we all compared code to code. This compares code to the database.
#
# It checks the code against PRODUCTION's committed constraint snapshot (db/constraints.prod.json),
# NOT against whatever database this machine happens to point at. That distinction is the whole
# lesson: production is the database that rejects writes, and sandbox was more permissive — a
# green run against sandbox proved nothing. The snapshot is checksum-verified against the database
# that produced it, so it cannot be hand-edited to make a failing gate go green.
#
# No credential, no network: it is a file. Which is why it runs on every machine, every push —
# unlike the version that needed a production password nobody was ever going to put in CI.
echo "🔗 Checking code↔database constraint contract..."
npm run check:db-contract > /tmp/db-contract.log 2>&1

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ CODE↔DATABASE CONTRACT VIOLATION — push blocked."
  cat /tmp/db-contract.log
  echo ""
  echo "   The code can write a value this database will not accept. Such a write fails"
  echo "   SILENTLY unless every caller checks the error — that is how the review queue"
  echo "   stayed empty for months. Fix the vocabulary or ship the migration."
  echo ""
  exit 1
fi

echo "🔨 Running build check before push (Node $(node -v))..."
npm run build > /dev/null 2>&1

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ BUILD FAILED — push blocked."
  echo "   Run 'npm run build' to see errors, fix them, then push again."
  echo ""
  exit 1
fi

echo "✅ Tests + build passed — pushing."
