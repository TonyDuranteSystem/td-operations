{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/bash-production-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-before-edit.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*__(portal_chat_send|gmail_send|gmail_draft|offer_send|lease_send|oa_send|portal_team_send|msg_send|portal_invoice_send)",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/send-guard.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__.*__execute_sql",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/production-write-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/checkpoint-counter.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/stop-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/post-push-qa.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/r095-gate.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/assumption-check.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/r093-verifier.sh",
            "timeout": 90
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pre-compact-save.sh",
            "timeout": 15
          },
          {
            "type": "prompt",
            "prompt": "CRITICAL: Context compaction is about to happen. The auto-save script just ran but it only saves a minimal checkpoint. You MUST NOW save DETAILED progress to dev_tasks via execute_sql with: (1) EVERY file changed, (2) EVERY commit hash, (3) EVERY CRM/DB update made, (4) exact state of in-progress work, (5) what is PENDING with specific details. Also sysdoc_update('session-context') if system state changed. This is your LAST CHANCE — after compaction you will NOT remember any of this.",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/user-prompt-contract.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-git-pull.sh",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/system-docs-index.sh",
            "timeout": 5
          },
          {
            "type": "prompt",
            "prompt": "Session starting. MANDATORY FIRST STEP: Read the git pull result above — if it pulled new commits, acknowledge what changed. Then follow CLAUDE.md Session Start protocol: (1) sysdoc_read('session-context'), (2) query dev_tasks for BOTH pending work (status in_progress/todo) AND recently completed (status done, ORDER BY updated_at DESC LIMIT 3) so you know what was JUST done, (3) git status + recent commits. Present: 'Last completed' + 'Pending' + 'Next steps' (from progress_log PENDING of most recent task). Then ask 'What do we work on?' — ALSO (R107): the System Reference Library was printed above; before working on any listed subsystem, read its docs/systems/<x>.md FIRST instead of re-deriving it from the DB/code. If you work on a subsystem that has NO doc there, CREATE it as part of the job.",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
