    "workflow_dispatch_log_outcome_check": "CHECK ((outcome = ANY (ARRAY['spawned'::text, 'no_trigger_match'::text, 'ambiguous'::text, 'snapshot_invalid'::text, 'meta_invalid'::text, 'spawn_failed'::text, 'already_spawned'::text])))",
    "workflow_dispatch_log_trigger_source_check": "CHECK ((trigger_source = ANY (ARRAY['form_submission'::text, 'sd_created'::text, 'chain'::text])))",
    "write_buffer_action_check": "CHECK ((action = ANY (ARRAY['CREATE'::text, 'UPDATE'::text, 'DELETE'::text])))",
    "write_buffer_status_check": "CHECK ((status = ANY (ARRAY['Pending'::text, 'Synced'::text, 'Failed'::text])))"
  }
}
