          "type": "document_viewer"
        },
        {
          "type": "chat"
        },
        {
          "type": "action_buttons",
          "actions": [
            {
              "key": "advance_next",
              "label": "State accepted: update our records",
              "target": "Update our records"
            }
          ]
        }
      ],
      "description": "Waiting for the state's answer. Upload the stamped document when it arrives. If the state refuses the name, mark it refused in the names list and send the job back for a new name."
