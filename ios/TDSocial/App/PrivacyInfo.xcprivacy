<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple's privacy manifest for TD Social (dev job 2072bc3e, App Store submission). The app does not track people. It stores two small things on the phone with
	     UserDefaults (whether it already asked about alerts, and the alert address it registered), which Apple calls a "required reason" use: CA92.1 = information
	     only the app itself reads. Nothing else the app uses needs a declared reason (no file dates, disk space, boot time or keyboard lists). -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
