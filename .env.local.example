# .env.local.example — committed template, no values
# Copy to .env.local (which is gitignored) and fill in real values.

# QA test accounts (used by Claude for browser-based UI verification)
# See CLAUDE.md → Tier 3 → QA reference → QA Test Accounts
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
# Staff-MFA rollout (dev job de4564ee): TOTP secret for the qa-staff account,
# so scripted browser QA can compute 6-digit codes (otplib). Set at prod
# rollout when qa-staff is enrolled. Never mirror into Vercel env.
QA_STAFF_TOTP_SECRET=

# Internal webhook secret (security audit 2026-06-13, H4).
# Gates the first-party offer-signed / agreement-signed webhooks. BOTH must be
# set to the SAME value on every deployment, or contract signing fails closed.
#   - INTERNAL_WEBHOOK_SECRET            : server-side, used to verify the header
#   - NEXT_PUBLIC_INTERNAL_WEBHOOK_SECRET: sent by the first-party signing pages
INTERNAL_WEBHOOK_SECRET=
NEXT_PUBLIC_INTERNAL_WEBHOOK_SECRET=

# ShipStation V2 API key (dev job 7c3ef909, docs/systems/flows.md 2026-09-09).
# Used by lib/shipstation.ts to check IRS mailing delivery status. ShipStation
# has no sandbox/test mode — this is a real production credential with
# all-or-nothing account access (no scoped/read-only key option exists).
# NOT YET GENERATED: this is a placeholder. Generating the real key, and
# turning on the daily check that uses it, is Antonio's own separate word —
# not implied by this code being built/sandbox-tested. When generated, rotate
# away from any key used during investigation/testing (a fresh key auto-
# retires the prior one).
SHIPSTATION_V2_API_KEY=
